# Secrets — jamais committés. Chaque service a son .env.example documenté.
.env
.env.*
!.env.example

# Outils locaux
.claude/settings.local.json

# Sorties de tests et de build
frontend/deploy/
nogoya-frontend.zip
nogoya-frontend.tar.gz
frontend/test-results/
frontend/playwright-report/
frontend/.next/
frontend/node_modules/
backend/.venv/
backend/media/
backend/staticfiles/
backend/logs/
# Exports deposes par les partenaires : leurs donnees, pas les notres.
backend/imports/*
!backend/imports/.gitkeep
**/__pycache__/
*.py[cod]

# Sorties de curl laissees par un diagnostic (curl -o r, -o g.json...).
# Un nom d'un ou deux caracteres a la racine d'un module n'est jamais un
# fichier du projet : trois fois qu'ils se faufilent dans un commit.
/backend/?
/backend/??
/backend/?.json
/backend/??.json
/frontend/?
/frontend/??
/frontend/?.json

# Système / éditeurs
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
