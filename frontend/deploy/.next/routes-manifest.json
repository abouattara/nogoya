{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/compte/fournisseur/produits/[slug]/modifier",
      "regex": "^/compte/fournisseur/produits/([^/]+?)/modifier(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/compte/fournisseur/produits/(?<nxtPslug>[^/]+?)/modifier(?:/)?$"
    },
    {
      "page": "/compte/messages/[id]",
      "regex": "^/compte/messages/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/compte/messages/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/fournisseurs/[id]",
      "regex": "^/fournisseurs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/fournisseurs/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/produits/[slug]",
      "regex": "^/produits/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/produits/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
