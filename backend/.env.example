# ==== Django ====
# Generate a new key for each environment (never commit real secrets)
DJANGO_SECRET_KEY=change-me-generate-a-real-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public address of the frontend (admin "view on site" links, CORS)
FRONTEND_URL=http://localhost:3000
DJANGO_SETTINGS_MODULE=config.settings.dev

# ==== Database (PostgreSQL) ====
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nogoya

# ==== Redis (channel layer, cache, celery broker, OTP) ====
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# ==== Email (leave console backend in dev) ====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NOGOYA <no-reply@nogoya.local>

# ==== SMS (Twilio) — optional, disabled if empty ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ==== Object storage (S3-compatible) ====
# USE_S3=False -> media files stay on the local filesystem (MEDIA_ROOT).
# USE_S3=True  -> any S3 API: MinIO in dev, Cloudflare R2 / AWS S3 in prod.
# See STORAGE.md for the MinIO and R2 recipes.
USE_S3=False
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=nogoya-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# "path" for MinIO, "virtual" for AWS S3 / R2 custom domains
S3_ADDRESSING_STYLE=path
# Optional CDN domain in front of the bucket (no scheme), e.g. media.nogoya.com
S3_PUBLIC_DOMAIN=

# ==== Upload limits ====
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=300
